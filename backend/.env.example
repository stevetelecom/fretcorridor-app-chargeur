# Copier ce fichier en .env (a la racine du repo, a cote de docker-compose.yml)
# et remplacer chaque valeur. .env est dans .gitignore : ne jamais le committer.

# --- Base de donnees ---
DB_NAME=fretcorridor
DB_USER=fretcorridor_user
DB_PASSWORD=change_me

# --- JWT (access token courte duree) ---
# Generer avec : openssl rand -base64 64
JWT_SECRET=change_me_en_local_uniquement
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mini-outil admin (module admin, protection X-Admin-Api-Key) ---
# Generer avec : openssl rand -hex 32
# Ne JAMAIS utiliser cette cle depuis l'app mobile chargeur - outil interne uniquement.
ADMIN_API_KEY=change_me_admin_key_en_local
